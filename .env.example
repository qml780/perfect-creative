# Local development only. Demo operations are disabled in production.
DEMO_MODE=true
BRAND_NAME=Perfect Creative
# Defaults to .data/demo.sqlite under the project.
DEMO_DB_PATH=
# These providers are not connected in the local build.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYMENTS_ENABLED=false
# Optional local Argos service. Start the local worker, then use http://127.0.0.1:3117.
LOCAL_TRANSLATION_URL=
# Optional server-side Google Cloud Translation (Basic v2) fallback when Argos is not configured.
TRANSLATION_API_KEY=
GA4_PROPERTY_ID=
MAIL_API_KEY=
