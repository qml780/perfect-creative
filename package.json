{
  "name": "perfect-creative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app lib public/site.js scripts tests",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/manage.mjs migrate",
    "admin:init": "node scripts/manage.mjs admin"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3"
  }
}
